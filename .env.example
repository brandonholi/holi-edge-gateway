# Environment Configuration for holi-edge-gateway
ENVIRONMENT=development
PORT=8080

# Redis Cloud (us-central1)
# holi-cache: noeviction=False, allkeys-lru, no persistence
REDIS_CACHE_URL=redis://localhost:6379/0
# holi-estado: noeviction=True, AOF persistence
REDIS_STATE_URL=redis://localhost:6379/1

# Odoo Backend (Odoo.sh or Local)
ODOO_BASE_URL=http://localhost:8081
ODOO_HMAC_SECRET=super_secret_hmac_key_shared_with_odoo
ODOO_MAX_CONCURRENT=20
ODOO_TIMEOUT_SECONDS=10.0

# Meilisearch (Search Engine)
MEILI_URL=http://localhost:7700
MEILI_KEY=

# Security & JWT (15 min access token)
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# Twilio Verify — OTP as a service (ADR-013)
# The auth token is a write credential: in Cloud Run it comes from Secret Manager,
# never from this file. Keep the placeholder here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_TIMEOUT_SECONDS=8.0
TWILIO_LOCALE=es
# SendGrid dynamic templates (d-...) for the e-mail channel; sources in plantillas/sendgrid/
TWILIO_EMAIL_TEMPLATE_EMAIL_VERIFICATION=
TWILIO_EMAIL_TEMPLATE_PASSWORD_RESET=

# Verification channels (RF-062). The contract also declares 'whatsapp';
# switch it on here once the WhatsApp template is approved. Sign-up only
# offers the phone channels among these; 'correo' serves password reset (ADR-017).
OTP_CHANNELS_ENABLED=sms,correo
OTP_CHANNEL_DEFAULT=sms

# OTP limits — these protect the invoice against SMS pumping
OTP_MAX_CHECK_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_PHONE_HOUR=3
OTP_MAX_SENDS_PER_PHONE_DAY=10
OTP_MAX_SENDS_PER_IP_HOUR=20

# Sign-up handshake lifetimes
REGISTRATION_DRAFT_TTL_SECONDS=900
OTP_SESSION_TTL_SECONDS=600
VERIFICATION_TOKEN_EXPIRE_MINUTES=10
PASSWORD_MIN_LENGTH=8

# RENIEC DNI lookup via json.pe (ADR-014). Each call spends a credit, so results
# are cached. The token is a billing credential: Secret Manager, not this file.
RENIEC_API_URL=https://api.json.pe/api/dni
RENIEC_API_TOKEN=
RENIEC_TIMEOUT_SECONDS=4.0
RENIEC_CACHE_TTL_SECONDS=86400
